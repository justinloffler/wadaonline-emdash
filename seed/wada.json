    "site_profile": [
      {
        "id": "site_profile:site",
        "slug": "site",
        "status": "published",
        "data": {
          "title": "Western Area Darts Association Inc.",
          "short_name": "WADA",
          "headline": "Every throw. Every team. Every Wednesday.",
          "tagline": "Wednesday nights · Western suburbs · Since 1989",
          "content": [
            {
              "_type": "block",
              "_key": "paragraph-0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "span-0",
                  "text": "WADA was formed to serve dart players in Adelaide's western suburbs, particularly the Port Adelaide region. It has always been a mixed competition, welcoming men and women in every team.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "paragraph-1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "span-1",
                  "text": "We began with 300 registered members playing on Monday and Wednesday nights. Today the main competition runs on Wednesdays, with satellite league nights on alternate Fridays.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "paragraph-2",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "span-2",
                  "text": "In 2022 WADA adopted its current logo, designed by sponsor Paul Meehan. It appears on the trophies, medals and premiership shields made and donated by Life Member Charlie Caruana.",
                  "marks": []
                }
              ]
            }
          ],
          "email": "wadadarts89@gmail.com",
          "facebook": "https://facebook.com/pages/Western-Area-Darts/251734721505204",
          "home_ground": "Seaton Park RSL",
          "home_address": "255 Tapleys Hill Road, Seaton SA 5023",
          "results_due": "All results to the Match Secretary by 6.00pm Thursday each week.",
          "eligibility_notice": "Players who are registered in and play three (3) games in a team must remain in that team. They may play in a higher division for a maximum of two (2) games. Loss of points will be taken if this is not observed — captains, please check the Rule Book."
        }
      }
    ]
  }
