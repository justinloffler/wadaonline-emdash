---
/** Team with its home venue and captain. Captains' phone numbers are deliberately not published. */
interface Props {
  number?: number;
  name: string;
  venue?: { name: string; address: string; phone?: string };
  venueNote?: string;
  captain?: string;
}
const { number, name, venue, venueNote, captain } = Astro.props;
const map = venue ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${venue.name}, ${venue.address}, SA`)}` : undefined;
---
<article class="team">
  <div class="title">
    {number !== undefined && <span class="num">{number}</span>}
    <h3>{name}</h3>
  </div>
  {venue ? (
    <div class="venue">
      <strong>{venue.name}{venueNote && ` (${venueNote})`}</strong>
      <span>{venue.address}</span>
      {venue.phone && <span>Venue {venue.phone}</span>}
    </div>
  ) : <p class="venue muted">Venue details coming soon.</p>}
  <div class="foot">
    <span>{captain ? <><span class="muted">Captain</span> <b>{captain}</b></> : ''}</span>
    {map && <a class="link-red" href={map} rel="noopener">Directions</a>}
  </div>
</article>

<style>
  .team { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .title { display: flex; align-items: center; gap: 12px; }
  .num { width: 38px; height: 38px; border-radius: var(--radius); background: var(--color-text); color: #fff; display: grid; place-items: center; font-family: var(--font-heading); flex-shrink: 0; }
  h3 { font-family: var(--font-heading); font-size: 20px; line-height: 1.1; }
  .venue { display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--color-text-secondary); }
  .venue strong { color: var(--color-text); }
  .foot { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-subtle); padding-top: 10px; font-size: 15px; margin-top: auto; }
  .foot a { padding: 10px 0; }
</style>
